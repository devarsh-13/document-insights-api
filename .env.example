# --- MongoDB (required, no defaults in code) ---
MONGO_URI=mongodb://localhost:1234
MONGO_DB_NAME=document_insights

# --- MongoDB connection pool tuning ---
MONGO_MIN_POOL_SIZE=5
MONGO_MAX_POOL_SIZE=50
MONGO_TIMEOUT_MS=5000

# --- API server ---
API_HOST=127.0.0.1
API_PORT=80

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Redis (required, no defaults in code) ---
REDIS_URL=redis://localhost:000/0
REDIS_MAX_CONNECTIONS=50
REDIS_TIMEOUT_SECONDS=2.0

# --- Business rules ---
MAX_ACTIVE_JOBS_PER_USER=3
SUMMARY_CACHE_TTL_SECONDS=86400
RATE_LIMIT_KEY_TTL_SECONDS=3600
MAX_CONTENT_LENGTH=100000

# --- Celery (broker on redis DB 1, separate from the cache on DB 0) ---
CELERY_BROKER_URL=redis://localhost:0000/1
CELERY_VISIBILITY_TIMEOUT_SECONDS=600

# --- Simulated AI work ---
JOB_MIN_DURATION_SECONDS=10
JOB_MAX_DURATION_SECONDS=30
JOB_FAILURE_RATE=0.1
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_BASE_SECONDS=5
JOB_RETRY_BACKOFF_MAX_SECONDS=300
